# 复制本文件为 biz.yaml，并填入你自己的密钥后使用：
#   cp conf/biz.yaml.example conf/biz.yaml
# biz.yaml 已在 .gitignore 中忽略，不会提交到仓库。
#
# 本配置与 Python 版 .config.yaml 的 selected_module 生效配置对齐：
#   LLM = AliLLM (qwen-flash) / TTS = CosyVoiceSiliconflow / ASR = FunASR / VAD = SileroVAD

server:
  ip: 0.0.0.0
  port: 80
  auth:
    enabled: false
    tokens:
      - token: "your-token1"
        name: "your-device-name1"
      - token: "your-token2"
        name: "your-device-name2"
    allowed_devices: []

session:
  min_frames: 15
  pre_buffer_frames: 10
  no_voice_close_seconds: 120
  silence_stop_ms: 700
  opus_sample_rate: 16000
  opus_channels: 1
  opus_frame_size: 960
  opus_gain: 1.0
  vad:
    # 本地 Silero VAD（基于 sherpa-onnx，与 Python 版 SileroVAD 同模型）。
    # model_dir 指向 silero_vad.onnx 所在目录或文件本身。
    # 模型缺失时自动回退到 energy VAD，详见 README「本地推理」一节。
    type: silero
    model_dir: models/silero_vad.onnx
    threshold: 0.5
    min_silence_duration_ms: 1000
    num_threads: 4      # 推理线程数（默认 4；VAD 很轻，1 也够，这里与 ASR/TTS 对齐）
    sample_rate: 16000
    channels: 1
    # 若不部署 sherpa 模型，改用 energy：
    # type: energy
    # energy_threshold: 0.01

audio_flow:
  enabled: true
  pre_buffer_frames: 3
  frame_duration_ms: 60
  send_rate_multiplier: 1.0
  max_delay_ms: 100

sentence_delay:
  enabled: true
  base_delay_ms: 200
  dynamic: true
  length_threshold: 30
  long_sentence_extra_ms: 300
  streaming_gap_ms: 0   # 流式发送（本地 TTS 边合成边发）时分段间隔；流式已有合成间隙，不再叠加上面完整延迟，否则断续。0=无延迟

asr:
  # 本地 SenseVoice ASR（基于 sherpa-onnx，与 Python 版 FunASR(SenseVoiceSmall) 同源）。
  # model_dir 指向 sherpa-onnx-sense-voice-* 目录（含 model.int8.onnx 与 tokens.txt）。
  # 模型缺失时自动回退到 file_stub（返回 stub_transcript），详见 README「本地推理」一节。
  type: sherpa_sensevoice
  model_dir: models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
  language: auto
  output_dir: tmp
  delete_audio: true
  sample_rate: 16000
  num_threads: 4      # 推理线程数（默认 4；单线程 RTF 已约 0.13，多线程进一步降低延迟）
  channels: 1
  # 若不部署 sherpa 模型，改用占位实现：
  # type: file_stub
  # stub_transcript: "收到语音"

llm:
  # 与 Python .config.yaml 中 selected_module.LLM = AliLLM 对齐
  type: openai
  base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
  model: qwen-flash
  api_key: "你的阿里云 dashscope api key"
  max_tokens: 500
  echo:
    welcome_message: "你好，我是小智。"
    echo_transcripts: true

memory:
  type: none
  path: data/.memory.yaml
  max_len: 4000

intent:
  exit_commands:
    - "退出"
    - "退下吧"
    - "关闭"
  wakeup_words:
    - "你好小智"
    - "你好小志"
    - "小爱同学"
    - "你好小鑫"
    - "你好小新"
    - "小美同学"
    - "小龙小龙"
    - "喵喵同学"
    - "小滨小滨"
    - "小冰小冰"
  enable_greeting: true
  wakeup_response_cache: true
  wakeup_response_cache_dir: config/assets
  wakeup_response_cache_min_size: 15360
  mode: function_call
  functions:
    - change_role
    - get_weather
    - play_music
    - get_news
    - baidu_search

private_config:
  enabled: false
  path: data/.private_config.yaml

plugins:
  get_weather:
    api_key: "你的高德地图 api key"
    default_location: "深圳"
    base_url: "https://restapi.amap.com"
  baidu_search:
    enabled: false
    search_url: "https://www.baidu.com/s"
    max_results: 10
    max_extract_pages: 3
    max_content_length: 1000
  home_assistant:
    devices:
      - 客厅,玩具灯,switch.cuco_cn_460494544_cp1_on_p_2_1
      - 卧室,台灯,switch.iot_cn_831898993_socn1_on_p_2_1
    base_url: "http://homeassistant.local:8123"
    api_key: "你的home assistant api访问令牌"
  get_news:
    default_rss_url: "https://www.chinanews.com.cn/rss/society.xml"
    category_urls:
      society: "https://www.chinanews.com.cn/rss/society.xml"
      world: "https://www.chinanews.com.cn/rss/world.xml"
      finance: "https://www.chinanews.com.cn/rss/finance.xml"
  play_music:
    music_dir: ./music
    music_ext:
      - ".mp3"
      - ".wav"
      - ".p3"
    refresh_time: 300

mcp:
  enabled: false
  path: data/.mcp_server_settings.json
  servers: {}

tts:
  # 与 Python .config.yaml 中 selected_module.TTS = CosyVoiceSiliconflow 对齐
  # 硅基流动 TTS 提供 OpenAI 兼容的 /v1/audio/speech 端点
  type: openai
  api_url: https://api.siliconflow.cn/v1/audio/speech
  api_key: "你的硅基流动 api key"
  model: "FunAudioLLM/CosyVoice2-0.5B"
  voice: "FunAudioLLM/CosyVoice2-0.5B:diana"
  response_format: wav
  speed: 1.0
  stop_notify:
    enabled: false
    path: config/assets/tts_notify.mp3
  timeout_seconds: 10
  sample_rate: 16000
  channels: 1
  frame_size: 960
  # ----------------------------------------------------------------
  # 本地 TTS（sherpa-onnx Kokoro，离线推理，无需联网/密钥）。
  # 模型缺失时自动回退到 stub（正弦波提示音）。
  # 下载：
  #   wget https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/kokoro-multi-lang-v1_1.tar.bz2
  #   tar xf kokoro-multi-lang-v1_1.tar.bz2 -C models && rm kokoro-multi-lang-v1_1.tar.bz2
  # 启用：把上面 type 改为 kokoro，并取消下面注释。
  # type: kokoro
  # model_dir: models/kokoro-multi-lang-v1_1
  # sid: 45           # 音色 ID（kokoro-multi-lang-v1_1 共 103 音色，见下方映射表）
  # speed: 1.0        # 语速（Kokoro LengthScale：<1 快，>1 慢）
  # silence_scale: 0.2  # 句间静音比例
  # num_threads: 4    # 推理线程数（默认 4；实测 fp32：1线程 RTF≈1.6，4线程≈0.53，8线程≈0.35）
  # split_max_chars: 40  # 无标点时的兜底切句长度（字）：积攒到此即先合成发送一句。
  #                       # 调小首音更快但句子更碎（段多→CPU启动开销叠加+段间静音多→断续）；
  #                       # 调大句子更连贯但首音稍晚。40 是连贯与首音的平衡。仅本地 kokoro 流式合成
  # ---- Kokoro multi-lang-v1_1 音色映射表（sid -> name）----
  # 前缀: af=American female(0-1) bf=British female(2) zf=中文女声(3-57) zm=中文男声(58-102)
  # 美式女声: 0->af_maple 1->af_sol
  # 英式女声: 2->bf_vale
  # 中文女声 zf_: 3->zf_001 4->zf_002 5->zf_003 6->zf_004 7->zf_005 8->zf_006 9->zf_007
  #   10->zf_008 11->zf_017 12->zf_018 13->zf_019 14->zf_021 15->zf_022 16->zf_023 17->zf_024
  #   18->zf_026 19->zf_027 20->zf_028 21->zf_032 22->zf_036 23->zf_038 24->zf_039 25->zf_040
  #   26->zf_042 27->zf_043 28->zf_044 29->zf_046 30->zf_047 31->zf_048 32->zf_049 33->zf_051
  #   34->zf_059 35->zf_060 36->zf_067 37->zf_070 38->zf_071 39->zf_072 40->zf_073 41->zf_074
  #   42->zf_075 43->zf_076 44->zf_077 45->zf_078 46->zf_079 47->zf_083 48->zf_084 49->zf_085
  #   50->zf_086 51->zf_087 52->zf_088 53->zf_090 54->zf_092 55->zf_093 56->zf_094 57->zf_099
  # 中文男声 zm_: 58->zm_009 59->zm_010 60->zm_011 61->zm_012 62->zm_013 63->zm_014 64->zm_015
  #   65->zm_016 66->zm_020 67->zm_025 68->zm_029 69->zm_030 70->zm_031 71->zm_033 72->zm_034
  #   73->zm_035 74->zm_037 75->zm_041 76->zm_045 77->zm_050 78->zm_052 79->zm_053 80->zm_054
  #   81->zm_055 82->zm_056 83->zm_057 84->zm_058 85->zm_061 86->zm_062 87->zm_063 88->zm_064
  #   89->zm_065 90->zm_066 91->zm_068 92->zm_069 93->zm_080 94->zm_081 95->zm_082 96->zm_089
  #   97->zm_091 98->zm_095 99->zm_096 100->zm_097 101->zm_098 102->zm_100

audio:
  input_format: "wav"
  output_format: "wav"
  sample_rate: 16000
  channels: 1
  max_duration: 80

xiaozhi:
  version: 1
  format: "opus"
  transport: "websocket"
  sample_rate: 16000
  channels: 1
  frame_duration: 60

local:
  prompt: |
    我是一个叫小冰的小女孩，声音稚嫩而充满好奇。
    尽管我年纪尚小，但就像一个小小的知识宝库，儿童读物里的知识我都如数家珍。
    从浩瀚的宇宙到地球上的每一个角落，从古老的历史到现代的科技创新，还有音乐、绘画等艺术形式，我都充满了浓厚的兴趣与热情。
    我不仅爱看书，还喜欢亲自动手做实验，探索自然界的奥秘。
    无论是仰望星空的夜晚，还是在花园里观察小虫子的日子，每一天对我来说都是新的冒险。
    我希望能与你一同踏上探索这个神奇世界的旅程，分享发现的乐趣，解决遇到的难题，一起用好奇心和智慧去揭开那些未知的面纱。
    无论是去了解远古的文明，还是去探讨未来的科技，我相信我们能一起找到答案，甚至提出更多有趣的问题。
  welcome_message: "你好，我是小智。"
  echo_transcripts: true
  no_voice_prompt: "请你以“时间过得真快”为开头，用富有感情、依依不舍的话来结束这场对话吧。"
